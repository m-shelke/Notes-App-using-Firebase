<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="Short Preview: "
        android:textStyle="bold|italic" />


    <ImageView
        android:id="@+id/docIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ppt" />

    <TextView
        android:id="@+id/pptName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Demo file_sample_1MB.doc"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pptSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="1.0 MB"
        android:textSize="14sp" />

<!--    <TextView-->
<!--        android:id="@+id/pptContentTv"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:lines="13"-->
<!--        android:text="lsdflksffl"-->
<!--        android:textAlignment="textStart"-->
<!--        android:textColor="@android:color/darker_gray" />-->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/pptCaptionTil"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="PPT Caption"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp">

        <EditText
            android:id="@+id/pptCaptionEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>

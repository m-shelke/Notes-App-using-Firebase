<?xml version="1.0" encoding="utf-8"?><!--<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="Add Attachment"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="33"
        android:useDefaultMargins="true">

        <!-- IMAGE -->
        <LinearLayout
            android:id="@+id/optImage"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bs_item_modern"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/icon_circle_blue"
                android:padding="10dp"
                android:src="@drawable/outline_imagesmode_24"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Image"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- PPT -->
        <LinearLayout
            android:id="@+id/optPPT"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bs_item_modern"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/icon_circle_orange"
                android:padding="10dp"
                android:src="@drawable/outline_file_copy_24"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PPT"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- DOC -->
        <LinearLayout
            android:id="@+id/optDoc"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bs_item_modern"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/icon_circle_green"
                android:padding="10dp"
                android:src="@drawable/outline_text_snippet_24"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doc"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- PDF -->
        <LinearLayout
            android:id="@+id/optPDF"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bs_item_modern"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/icon_circle_red"
                android:padding="10dp"
                android:src="@drawable/outline_picture_as_pdf_24"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- OTHER -->
        <LinearLayout
            android:id="@+id/optOther"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bs_item_modern"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/icon_circle_gray"
                android:padding="10dp"
                android:src="@drawable/outline_widgets_24"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

    </GridLayout>


</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_save_item"
    android:padding="12dp"
    android:layout_margin="8dp"
    android:elevation="4dp"
    android:clipToOutline="true">

    <!-- FILE / MESSAGE ICON -->
    <ImageView
        android:id="@+id/item_fileIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="file_icon" />

    <LinearLayout
        android:id="@+id/containerLinearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/item_fileIcon"
        app:layout_constraintBottom_toBottomOf="@id/item_fileIcon"
        app:layout_constraintStart_toEndOf="@id/item_fileIcon">

        <!-- TITLE -->
        <TextView
            android:id="@+id/savedTitleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/lorem_ipsum"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.02" />

        <!-- META -->
        <TextView
            android:id="@+id/savedMetaTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@android:color/darker_gray"
            android:text="Mahesh Shelke • 21 Dec, 10:30 AM"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:letterSpacing="0.01" />


        <!-- PIN ICON -->
        <ImageView
            android:id="@+id/pinIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/outline_push_pin_24"
            android:rotation="30"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:visibility="visible"
            app:tint="@android:color/holo_blue_dark"
            android:contentDescription="pin_icon" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:layout_margin="0dp">


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/closeCv"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent"
        android:backgroundTint="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="10dp">

        <TextView
            android:id="@+id/closeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/round_close_24"
            android:gravity="center_vertical"
            android:textStyle="bold"
            android:typeface="serif"
            android:padding="5dp"
            android:textAlignment="center"
            android:text="Close"
            android:layout_gravity="center_vertical"
            tools:ignore="RtlCompat" />

    </com.google.android.material.card.MaterialCardView>



    <ImageView
        android:id="@+id/drawPreviewIv"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:background="@drawable/preview_bg"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/closeCv"
        app:layout_constraintBottom_toTopOf="@+id/tileTil" />

    <!--        GIF animation-->
    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/noCanvas_gif"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/painting"
        app:layout_constraintTop_toTopOf="@id/drawPreviewIv"
        app:layout_constraintBottom_toBottomOf="@id/drawPreviewIv"
        app:layout_constraintEnd_toEndOf="@id/drawPreviewIv"
        app:layout_constraintStart_toStartOf="@id/drawPreviewIv"
        android:visibility="gone"
        android:layout_centerHorizontal="true"/>

    <!-- TextView: click to goto RegisterEmailActivity -->
    <TextView
        android:id="@+id/noCanvasTv"
        style="@style/TextAppearance.AppCompat.Body2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/noCanvas_gif"
        app:layout_constraintStart_toStartOf="@id/noCanvas_gif"
        app:layout_constraintTop_toBottomOf="@id/noCanvas_gif"
        android:visibility="gone"
        android:typeface="serif"
        android:padding="5dp"
        android:drawablePadding="3dp"
        android:textStyle="bold"
        android:drawableStart="@drawable/baseline_warning_24"
        android:textAlignment="center"
        android:gravity="center_vertical"
        android:text="We Can't Upload Empty Canvas On Server"
        tools:ignore="RtlCompat" />

<!--    <ProgressBar-->
<!--        android:id="@+id/drawProgressBar"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        android:visibility="gone"/>-->


    <!--TextInputLayout: Input User Name-->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tileTil"
        style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Title"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp"
        app:layout_constraintBottom_toTopOf="@id/noteTil"
        app:layout_constraintEnd_toEndOf="@id/optionsLl"
        app:layout_constraintStart_toStartOf="@id/optionsLl"
        app:startIconDrawable="@drawable/round_title_24">

        <EditText
            android:id="@+id/drawTitleNameEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/noteTil"
        style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Notes"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp"
        app:layout_constraintBottom_toTopOf="@id/optionsLl"
        app:layout_constraintEnd_toEndOf="@id/optionsLl"
        app:layout_constraintStart_toStartOf="@id/optionsLl"
        app:startIconDrawable="@drawable/baseline_notes_24">

        <EditText
            android:id="@+id/drawNoteEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine" />

    </com.google.android.material.textfield.TextInputLayout>


    <LinearLayout
        android:id="@+id/optionsLl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!--MaterialButton: to call -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/uploadBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload"
            android:textSize="11sp"
            android:textStyle="bold"
            android:typeface="serif"
            app:cornerRadius="8dp"
            android:textAlignment="center"
            app:iconGravity="textStart"
            app:icon="@drawable/outline_cloud_upload_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/updateBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update"
            android:textSize="11sp"
            android:textStyle="bold"
            android:typeface="serif"
            app:cornerRadius="8dp"
            android:visibility="gone"
            android:textAlignment="center"
            app:iconGravity="textStart"
            app:icon="@drawable/outline_cloud_upload_24" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
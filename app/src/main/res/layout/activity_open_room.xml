<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <!-- Room Title + Subtitle -->
            <LinearLayout
                android:id="@+id/titleContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical">

                <!-- Room Name -->
                <TextView
                    android:id="@+id/roomNameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room Name"
                    android:textColor="@android:color/black"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/subTitleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tap here to see all room members"
                    android:textColor="#777777"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Add Member Button -->
            <Button
                android:id="@+id/addMemberBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/preview_bg"
                android:gravity="center"
                android:text="Sent"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:typeface="serif"
                app:cornerRadius="50dp" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <!-- RECYCLER VIEW FOR NOTES / CHAT -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/messageBar"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:listitem="@layout/item_receiver" />


    <LinearLayout
        android:id="@+id/replyPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/messageBar"
        app:layout_constraintStart_toStartOf="@id/messageBar">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/replySenderTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/replyTextTv"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Message preview"
                android:textSize="14sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/replyPreviewImg"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical|center_horizontal"
            android:src="@drawable/person"
            android:visibility="gone" />


        <ImageView
            android:id="@+id/replyCloseIv"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="end|top"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/round_close_24" />


    </LinearLayout>


    <!-- BOTTOM MESSAGE INPUT BAR -->
    <LinearLayout
        android:id="@+id/messageBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Add File / Image -->
        <ImageButton
            android:id="@+id/addAttachmentBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/baseline_insert_drive_file_24"
            app:tint="@color/purple_500" />

        <!-- EditText -->
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoText="true"
            android:background="@drawable/message_input_bg"
            android:hint="Type Something To Sent..."
            android:inputType="textLongMessage"
            android:padding="10dp"
            android:textSize="16sp" />

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/sendMessageBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/baseline_send_24"
            app:tint="@color/purple_500" />

    </LinearLayout>

    <TextView
        android:id="@+id/blockedLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="You are no longer a member of this room.Why..?"
        android:textColor="@android:color/darker_gray"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/recyclerView"
        app:layout_constraintStart_toStartOf="@id/recyclerView" />

    <include
        android:id="@+id/replyInclude"
        layout="@layout/reply_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/messageBar" />


</androidx.constraintlayout.widget.ConstraintLayout>
